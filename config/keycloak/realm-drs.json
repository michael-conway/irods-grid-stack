{
  "realm": "drs",
  "enabled": true,
  "displayName": "DRS",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "defaultScope": "openid profile email",
        "clientId": "${GOOGLE_OIDC_CLIENT_ID}",
        "clientSecret": "${GOOGLE_OIDC_CLIENT_SECRET}",
        "prompt": "select_account",
        "syncMode": "IMPORT"
      }
    }
  ],
  "clients": [
    {
      "clientId": "${DRS_API_CLIENT_ID}",
      "name": "DRS API Resource Server",
      "description": "Confidential client used by the DRS REST API for token introspection and protected resource access",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${DRS_API_CLIENT_SECRET}",
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocolMappers": []
    },
    {
      "clientId": "${IRODS_REST_WEB_CLIENT_ID}",
      "name": "iRODS REST Web Login",
      "description": "OIDC client used by irods-go-rest for browser-based login and callback handling",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${IRODS_REST_WEB_CLIENT_SECRET}",
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8080/web/callback",
        "http://localhost:8082/web/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:8082"
      ],
      "protocolMappers": [
        {
          "name": "audience-irods-go-rest",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "irods-go-rest",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "${STARBASE_WEB_CLIENT_ID}",
      "name": "Starbase SPA",
      "description": "Public OIDC client used by Starbase direct browser PKCE sign-in",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8081/auth/callback",
        "http://localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8081",
        "http://localhost:5173"
      ],
      "protocolMappers": [
        {
          "name": "audience-irods-go-rest",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "irods-go-rest",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
